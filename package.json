{
  "name": "shared.onboarding",
  "version": "1.0.0",
  "description": "Shared LFI portfolio onboarding manual",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "preview:cloudflare": "npm run build:vinext && npm run start:vinext",
    "deploy:cloudflare": "npm run build:vinext && npm run deploy:vinext",
    "dry-run:cloudflare": "npm run build:vinext && wrangler deploy --dry-run --config dist/server/wrangler.json",
    "cf-typegen": "wrangler types --config wrangler.jsonc --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@vinext/cloudflare": "^1.0.0-beta.7",
    "lucide-react": "^0.408.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-server-dom-webpack": "^19.2.8",
    "remark-gfm": "^4.0.1",
    "vinext": "^1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.6",
    "@mdx-js/react": "^3.0.0",
    "@next/mdx": "^15.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "autoprefixer": "^10",
    "jspdf": "^2.5.0",
    "next-mdx-remote": "^6.0.0",
    "postcss": "^8",
    "tailwindcss": "^4.0.0",
    "typescript": "^5",
    "vite": "^8.2.2",
    "wrangler": "^4.130.0"
  },
  "type": "module"
}
